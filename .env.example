# Local environment (copy to .env and adjust values)
#
# حالت نمایشی: دیتابیس لازم نیست — همهٔ داده‌ها از src/lib/catalog.ts می‌آیند.
# اگر بعداً PostgreSQL وصل کردید، DATABASE_URL را تنظیم کنید و
# src/lib/data.ts را به حالت Drizzle برگردانید.
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Optional: admin panel credentials (default demo password: zarnab1405)
# ADMIN_PASSWORD=change-me
# ADMIN_SECRET=long-random-string

# Public site URL used for canonical/OG/JSON-LD metadata
NEXT_PUBLIC_SITE_URL=https://zarnab.ir
